# Copy to deploy.env (git-ignored) and fill in. In CI, set the same names as variables.
DEPLOY_HOST=my-docker-host          # ssh host or ~/.ssh/config alias
DEPLOY_PATH=/opt/kronos             # compose project directory on that host
DEPLOY_URL=https://kronos.example   # what the smoke test hits
# DEPLOY_CONTAINER=kronos           # optional, default: kronos
