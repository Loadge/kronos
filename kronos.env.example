# Copy to kronos.env (git-ignored) and fill in: where `python bin/kronos.py --target X` points.
# The environment wins over this file. `local` falls back to http://localhost:8765 when unset;
# `int` and `prod` have no default, so a typo can never aim a write at the wrong place.
KRONOS_LOCAL_URL=http://localhost:8765
KRONOS_INT_URL=http://kronos-int.example
KRONOS_PROD_URL=https://kronos.example
# Where the safety backups go (default: ./backups/<target>/, git-ignored; the newest 50 are kept).
# KRONOS_BACKUP_DIR=/path/to/backups
